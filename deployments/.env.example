# PostgreSQL credentials for the compose stack. Use a long random value.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Exactly 16, 24, or 32 ASCII bytes. Changing this after storing channel keys
# prevents the gateway from decrypting those existing keys.
CHANNEL_KEY_ENCRYPTION_KEY=replace-with-32-byte-encryption-key

# Optional runtime settings.
LLMGATEWAY_PORT=8080
UPSTREAM_REQUEST_TIMEOUT=60
UPSTREAM_MAX_ATTEMPTS=3
QUOTA_DEFAULT_MAX_TOKENS=4096
CHANNEL_MIN_ROUTE_BALANCE=0.000000
